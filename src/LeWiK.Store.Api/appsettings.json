{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Reservations": {
    "Enabled": true,
    "TtlMinutes": 30,
    "PaymentGraceMinutes": 20,
    "SweepIntervalSeconds": 60,
    "BatchSize": 100
  },
  "Tenancy": {
    "BaseDomain": "lewik.app",
    "AllowHeaderOverride": false
  }
}
