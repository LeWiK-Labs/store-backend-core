{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  // Same TTL as production on purpose. Much of the smoke test works on an unpaid order across
  // several sections (the order from §7 is paid in §9, the refunds of §12c run on one charge), so
  // a short window puts the sweeper underneath assertions that have nothing to do with
  // reservations: measured, a zero window fails 54 of them. A one-minute window does pass today —
  // by about ten seconds — which is a margin, not a design. Only the sweep interval is shortened,
  // so a deadline moved into the past (how §20 tests this without waiting half an hour) is
  // noticed in seconds.
  "Reservations": {
    "Enabled": true,
    "TtlMinutes": 30,
    "PaymentGraceMinutes": 20,
    "SweepIntervalSeconds": 10,
    "BatchSize": 100
  },
  // *.localhost resolves to 127.0.0.1 in modern browsers and curl, so cardshop.localhost
  // exercises the production resolution path without touching the hosts file.
  "Tenancy": {
    "BaseDomain": "localhost",
    "AllowHeaderOverride": true
  },
  "ConnectionStrings": {
    "Default" : "Host=localhost;Port=5432;Database=lewik_store;Username=lewik;Password=lewik_dev",
    "Redis": "localhost:6379"
  },
  "Platform": {
    "SeedOperatorEmail": "admin@lewik.cl",
    "SeedOperatorPassword": "cambiar-esto-ya-1234"
  },
  "Payments": {
    "ReturnUrlBase": "http://localhost:5223",
    "StorefrontResultUrl": "http://localhost:4200/pago/resultado",
    "StorefrontPayUrlBase": "http://localhost:4200/pagar"
  }
}
